{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["shared/api-client/src/generated/**", "client/web/src/components/ui/**"],
  "ignoreBinaries": ["act"],
  "workspaces": {
    ".": {
      "entry": ["tools/**/*.{ts,mjs}!"]
    },
    "client/web": {
      "entry": ["e2e/global-{setup,teardown}.ts"],
      "playwright": {
        "config": ["e2e/playwright.config.ts"]
      }
    },
    "backend/services/api": {
      "project": ["src/**/*.ts!", "test/**/*.ts"],
      "ignoreDependencies": ["pino-pretty", "@types/ws"]
    },
    "backend/services/worker": {
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "backend/packages/db": {
      "entry": ["src/main.ts!"],
      "project": ["src/**/*.ts!", "test/**/*.ts"],
      "includeEntryExports": true
    },
    "backend/packages/game": {
      "project": ["src/**/*.ts!", "test/**/*.ts"],
      "includeEntryExports": true
    },
    "shared/core": {
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    }
  }
}
