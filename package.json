{
  "name": "marchlands",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared/*",
    "backend/packages/*",
    "backend/services/*",
    "client/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/web --noEmit && tsc -p tools/art --noEmit",
    "test": "vitest run",
    "test:db": "vitest run -c vitest.db.config.ts",
    "lint": "eslint . && npm run knip && npm run sherif",
    "lint:fix": "eslint . --fix",
    "knip": "knip && knip --production --workspace 'backend/**'",
    "sherif": "sherif -r root-package-manager-field",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "npm run dev -w @marchlands/api",
    "dev:worker": "npm run dev -w @marchlands/worker",
    "db:generate": "npm run generate -w @marchlands/db",
    "db:migrate": "npm run migrate -w @marchlands/db",
    "legacy:convert": "node tools/legacy-import/convert.mjs",
    "smoke": "node tools/smoke/smoke.mjs && node tools/smoke/war.mjs && node tools/smoke/market.mjs",
    "docs:api": "node tools/docs/gen-api-md.mjs",
    "ci:local": "act workflow_dispatch",
    "art:draw": "node tools/art/draw.ts",
    "art:placeholders": "node tools/art/placeholders.ts",
    "sim": "node tools/battle-sim/sim.ts",
    "delete-player": "node --env-file-if-exists=.env tools/dev/delete-player.ts",
    "load": "node --env-file-if-exists=.env tools/smoke/load.mjs",
    "gen:api": "node backend/services/api/src/openapi.ts && npm run generate -w @marchlands/api-client && npm run docs:api",
    "dev:web": "npm run dev -w @marchlands/web",
    "build:web": "npm run build -w @marchlands/web",
    "build:backend": "node tools/build/backend.mjs",
    "trace": "node tools/build/trace.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@marchlands/core": "*",
    "@marchlands/db": "*",
    "@marchlands/game": "*",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@vitest/eslint-plugin": "1.6.27",
    "altcha-lib": "2.6.0",
    "drizzle-orm": "^0.45.3",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-drizzle": "0.2.3",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-regexp": "3.3.1",
    "globals": "^17.13.0",
    "knip": "6.38.0",
    "prettier": "^3.9.10",
    "sherif": "1.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
