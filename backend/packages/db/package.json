{
  "name": "@marchlands/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Postgres schema (Drizzle), migrations and connection helpers.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./test/*": "./test/*"
  },
  "imports": {
    "#/*": "./src/*",
    "#test/*": "./test/*"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../../.env src/main.ts"
  },
  "dependencies": {
    "@marchlands/core": "*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
