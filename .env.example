# Copy to .env and adjust. docker compose reads this file automatically.
POSTGRES_USER=evony
POSTGRES_PASSWORD=evony
POSTGRES_DB=evony
POSTGRES_PORT=5432
API_PORT=3000

# Used by the services when running outside docker (npm run dev:api / dev:worker)
DATABASE_URL=postgres://evony:evony@localhost:5432/evony

JWT_SECRET=change-me-in-production
LOG_LEVEL=info

# World generation on first boot: "generated" (procedural, seeded by WORLD_SEED)
# or "legacy" (the 800x800 tile layout imported from the original s2 dump).
WORLD_MAP=generated
WORLD_SEED=evony

# Multiplies the speed of every timer (build, research, training, marching). 1 = original pace.
GAME_SPEED=1

# Usernames that are always operators (comma separated). The first account ever registered is one too.
ADMIN_USERNAMES=
