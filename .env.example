# Development settings: copy to .env and adjust. docker compose reads this file automatically.
# For the server, use .env.production.example instead (docs/deployment.md).
POSTGRES_USER=marchlands
POSTGRES_PASSWORD=marchlands
POSTGRES_DB=marchlands
POSTGRES_PORT=5432
API_PORT=3000
# browser client: nginx in docker (WEB_PORT) or the Vite dev server (npm run dev:web, port 5173)
WEB_PORT=8000

# Used by the services when running outside docker (npm run dev:api / dev:worker)
DATABASE_URL=postgres://marchlands:marchlands@localhost:5432/marchlands

JWT_SECRET=change-me-in-production
LOG_LEVEL=info

# World generation on first boot: "generated" (procedural, seeded by WORLD_SEED)
# or "legacy" (the 800x800 tile layout imported from the original s2 dump).
WORLD_MAP=generated
WORLD_SEED=marchlands

# Multiplies the speed of every timer (build, research, training, marching). 1 = original pace.
GAME_SPEED=1

# Usernames that are always operators (comma separated). The first account ever registered is one too.
ADMIN_USERNAMES=
