# Production settings for the dedicated host (docs/deployment.md). Copy to .env on the server and fill in.
# docker compose reads .env automatically; keep it out of git and readable by its owner only (chmod 600 .env).

# Use the production overrides (docker-compose.prod.yml) with every plain `docker compose …` command.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# HTTPS through Caddy: uncomment both lines below, point DOMAIN's DNS at this machine and open ports 80 and 443.
# COMPOSE_PROFILES=https
# DOMAIN=game.example.com

# --- secrets (required: compose refuses to start without them) -------------------------------------------
# generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# --- ports ----------------------------------------------------------------------------------------------
# The public entrance is the web container (the client, and /api, /ws, /docs proxied to the API).
# Without HTTPS: WEB_BIND=0.0.0.0 and WEB_PORT=80. With the https profile Caddy takes 80/443, so set
# WEB_BIND=127.0.0.1 and WEB_PORT=8000.
WEB_BIND=0.0.0.0
WEB_PORT=80
# Only reachable from the machine itself (127.0.0.1), e.g. over an SSH tunnel.
POSTGRES_PORT=5432
API_PORT=3000
ADMINER_PORT=8080

# --- database -------------------------------------------------------------------------------------------
POSTGRES_USER=marchlands
POSTGRES_DB=marchlands
# For tools run on the host itself (npm run delete-player, npm run db:migrate): Postgres on 127.0.0.1.
# Use the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgres://marchlands:CHANGE_ME@127.0.0.1:5432/marchlands

# --- game -----------------------------------------------------------------------------------------------
# Multiplies the speed of every game timer. 1 = the original pace.
GAME_SPEED=1
# World generation on first boot (ignored once a world exists, e.g. after restoring a backup):
# "generated" (procedural, seeded by WORLD_SEED) or "legacy" (the original 800x800 layout).
WORLD_MAP=generated
WORLD_SEED=marchlands
# Usernames that are always operators (comma separated). On an empty database the first account ever
# registered is an operator too, so register yours first or list it here.
ADMIN_USERNAMES=

LOG_LEVEL=info
